# Server-only — used by the route handlers in src/app/api/auth/** to call Strapi.
# Never exposed to the client (no NEXT_PUBLIC_ prefix).
STRAPI_URL=http://localhost:1337

# Public — Strapi's origin, needed client-side for the "Continue with Google" link
# and the OAuth redirect page's fetch. Not a secret, just Strapi's public API URL.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
