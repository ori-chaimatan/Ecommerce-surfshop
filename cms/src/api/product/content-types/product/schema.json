{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Every catalog product — boards, apparel, wetsuits, accessories"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true
    },
    "Slug": {
      "type": "uid",
      "targetField": "Name",
      "required": true
    },
    "Category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "required": true,
      "inversedBy": "Products"
    },
    "Subcategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::subcategory.subcategory",
      "inversedBy": "Products"
    },
    "Gender": {
      "type": "enumeration",
      "enum": [
        "Men",
        "Women",
        "Unisex"
      ]
    },
    "Price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "Images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "Subtitle": {
      "type": "string"
    },
    "Description": {
      "type": "richtext",
      "required": true
    },
    "Featured": {
      "type": "boolean",
      "default": false
    },
    "SizeType": {
      "type": "enumeration",
      "enum": [
        "Surfboard",
        "Standard"
      ],
      "required": true
    },
    "BoardSizes": {
      "type": "component",
      "component": "product.board-size",
      "repeatable": true,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "SizeType"
            },
            "Surfboard"
          ]
        }
      }
    },
    "StandardSizes": {
      "type": "component",
      "component": "product.standard-size",
      "repeatable": true,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "SizeType"
            },
            "Standard"
          ]
        }
      }
    },
    "SurfboardSpecs": {
      "type": "component",
      "component": "product.surfboard-specs",
      "repeatable": false
    }
  }
}
