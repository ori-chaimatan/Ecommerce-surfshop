{
  "collectionName": "components_home_hero_slides",
  "info": {
    "displayName": "Hero slide",
    "icon": "picture",
    "description": "One slide of the Home page hero carousel"
  },
  "options": {},
  "attributes": {
    "headline": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "subtext": {
      "type": "text",
      "maxLength": 200
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "ctaLabel": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "ctaHref": {
      "type": "string",
      "required": true
    },
    "Hero": {
      "type": "component",
      "component": "shared.carousel-hero",
      "repeatable": false
    }
  }
}
