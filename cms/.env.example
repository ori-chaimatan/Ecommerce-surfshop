HOST=0.0.0.0
PORT=1337
# Absolute URL this Strapi instance is reachable at — used to build OAuth
# redirect_uris (see server.ts). Update for non-local environments.
SERVER_URL=http://localhost:1337
CLIENT_URL=http://localhost:3000
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Resend (email delivery, via @strapi/provider-email-nodemailer + Resend's SMTP
# relay) — required for forgot/reset password emails to actually send. Get a
# free API key at https://resend.com (sign up, then Dashboard → API Keys →
# Create API Key). Sending works immediately with no domain verification via
# Resend's onboarding@resend.dev sandbox sender, but until you verify your own
# domain in Resend, it can only deliver to the email address you signed up with.
RESEND_API_KEY=

# Google OAuth ("Continue with Google") — optional. Leave both empty to leave
# the provider disabled; the app runs fine without them (see cms/src/index.ts
# bootstrap()). To enable: create an OAuth 2.0 Client ID (Web application)
# in Google Cloud Console, and set its Authorized redirect URI to exactly:
#   {SERVER_URL}/api/connect/google/callback  (e.g. http://localhost:1337/api/connect/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
